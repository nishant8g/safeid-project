{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/sw.js",
      "dest": "/frontend/sw.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate",
        "content-type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "/frontend/manifest.json",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate",
        "content-type": "application/manifest+json; charset=utf-8"
      }
    },
    {
      "src": "/resq-logo-192.png",
      "dest": "/frontend/resq-logo-192.png"
    },
    {
      "src": "/resq-logo-512.png",
      "dest": "/frontend/resq-logo-512.png"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
