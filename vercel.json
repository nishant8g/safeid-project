{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/vite"
    },
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/api/user/(.*)",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/api/qr/(.*)",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/api/scan/(.*)",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/api/alert/(.*)",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/api/ai/(.*)",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/api/health",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/docs",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/openapi.json",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
