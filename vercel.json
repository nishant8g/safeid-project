{
  "version": 2,
  "cleanUrls": true,
  "framework": "vite",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(sw.js|manifest.json|favicon.svg|icons.svg|safeid-logo-192.png|safeid-logo-512.png)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
