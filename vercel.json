{
  "version": 2,
  "builds": [
    {
      "src": "server/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/server/(.*)",
      "destination": "server/index.py"
    },
    {
      "source": "/((?!server/).*)",
      "destination": "/index.html"
    }
  ]
}
