{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(assets|icons.svg|favicon.svg|manifest.json|sw.js|safeid-logo-192.png|safeid-logo-512.png)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(scan|login|register|dashboard|profile|contacts|qr|nfc|history|auth|user|alert)/:path*",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/((?!api|frontend).* )",
      "destination": "/frontend/index.html"
    }
  ]
}
