{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/vite"
    },
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/docs(.*)",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/user/(.*)",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/qr/(.*)",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/scan/(.*)",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/alert/(.*)",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/ai/(.*)",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
